# Copie para .env.local (esse arquivo NÃO vai pro git) e preencha.
# Banco Postgres (Neon, plano grátis): https://neon.tech  ->  Connection string
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require

# Tempo real (opcional). Sem isso o jogo roda em "modo teste" (só enxerga abas do mesmo navegador).
# Supabase (grátis): Project Settings -> API -> Project URL e a chave publishable/anon.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Use um nome de sala só seu pra não misturar com quem joga em produção.
REALTIME_ROOM=buteco-dev-SEUNOME
